# Copy to .env (never commit .env) and fill in real values.
# In CI/CD these come from GitHub Actions secrets instead.

# ── Images (set by CI; leave default for local builds) ───────────────────────
REGISTRY=ghcr.io/rahul-bhagat_balict
IMAGE_TAG=latest

# ── Host paths for persistent data ───────────────────────────────────────────
DATA_ROOT=/var/www/html/TestManagementSystem

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
POSTGRES_DB=test_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ── App session JWT (REQUIRED, >= 64 random chars) ───────────────────────────
# Generate:  openssl rand -hex 64
JWT_SECRET=change-me
JWT_EXPIRATION=86400000

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://10.3.41.102
CORS_ALLOWED_ORIGINS=http://10.3.41.102

# ── IDEM / RH-SSO (backend and frontend MUST point to the same realm) ────────
IDEM_ISSUER_URI=https://secure-sso-rhsso-np.apps.ocplife-np.bajajlife.com/auth/realms/internal
IDEM_CLIENT_ID=TMT
IDEM_REDIRECT_URI=http://10.3.41.102/api/v1/auth/idem/callback
IDEM_POST_LOGIN_REDIRECT=http://10.3.41.102/login
VITE_KEYCLOAK_URL=https://secure-sso-rhsso-np.apps.ocplife-np.bajajlife.com/auth
VITE_KEYCLOAK_REALM=internal
VITE_KEYCLOAK_CLIENT_ID=TMT

# ── Misc ─────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
JPA_DDL_AUTO=validate
APP_LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
