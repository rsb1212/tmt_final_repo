[Rahul.Bhagat@L5SRL2TMS01 TestManagementSystem]$ cat nginx.conf
# Nginx Configuration Block for Test Management System (v2.0)
# Deploy this configuration in your Nginx config directory (e.g., /etc/nginx/sites-available/default)

server {
    listen 80;
    server_name testgenii.bajajlife.com;

    # React Frontend
    root /usr/share/testpage;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
        gzip on;
        gzip_types
            text/plain
            text/css
            application/json
            application/javascript
            text/xml
            application/xml;
    }
    # Spring Boot Backend API
     location /api/ {
    proxy_pass http://127.0.0.1:8080;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;

    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;

    proxy_http_version 1.1;

    client_max_body_size 10M;
}
}
